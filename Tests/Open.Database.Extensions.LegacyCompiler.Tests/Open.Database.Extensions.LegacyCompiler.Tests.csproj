<Project Sdk="Microsoft.NET.Sdk">

	<!--
		What a consumer on an older compiler gets. Each target compiles this project with the language version that consumers of that target commonly still have:
		net472 with C# 7.3 (the .NET Framework default), net8.0 with C# 9 (before [CallerArgumentExpression]) and net10.0 with C# 12 (before [OverloadResolutionPriority]).
		The test code itself is written to compile as C# 7.3: explicit usings, no nullable annotations, no records, no `is not`, no target-typed `new`.
		The library under test is the build that target selects: netstandard2.0 on net472, netstandard2.1 on net8.0, net10.0 on net10.0.
	-->
	<PropertyGroup>
		<TargetFrameworks>net472;net8.0;net10.0</TargetFrameworks>
		<!-- xUnit v3 test projects are executables. -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<LangVersion>7.3</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<LangVersion>9.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<LangVersion>12.0</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Core\Open.Database.Extensions.Core.csproj" />
	</ItemGroup>

</Project>
