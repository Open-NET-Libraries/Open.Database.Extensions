<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Useful set of utilities and abstractions for simplifying modern data-access operations and ensuring DI compatibility.</Description>
		<PackageTags>ado;ado extensions;sql;connection factory;extensions;</PackageTags>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
	</ItemGroup>

	<!-- Public API surface tracking (clean-upgrade-path guardrail). Enabled on the modern
	     target only; the public API legitimately differs on the netstandard/net472 shims.
	     The package's own targets add PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt as AdditionalFiles
	     when they sit next to the project, so they are not listed here (listing them added each file twice). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- The sibling assemblies use Core's internals: the internal OverloadResolutionPriorityAttribute polyfill on the netstandard shims, and on every
	     target the conversion of the tuple convenience overloads into a RowMap<T>. -->
	<ItemGroup>
	  <InternalsVisibleTo Include="Open.Database.Extensions.Channel" />
	  <InternalsVisibleTo Include="Open.Database.Extensions.Dataflow" />
	  <InternalsVisibleTo Include="Open.Database.Extensions.SqlClient" />
	  <InternalsVisibleTo Include="Open.Database.Extensions.MSSqlClient" />
	</ItemGroup>

	<!-- In-box on net10; only needed as a package on the netstandard shims (avoids NU1510 on net10). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
	  <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.14" />
	</ItemGroup>

	<!-- Minimum version only (not exact-pinned): keeps the floor low so netstandard consumers aren't forced to a newer minimum, while still allowing their own app's dependency graph to resolve a higher version if needed. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Threading.Channels" Version="10.0.14" />
		<PackageReference Include="System.Collections.Immutable" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' ">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>

</Project>
